# Where contact-form messages go. Set at least one; a message counts as sent when any one accepts it.
# With none set, the form answers 503 and tells the visitor to email info@ion.co.cr.

# Recommended: Formspree (stores every message in a dashboard and emails it; no DNS records needed).
# Create a form at formspree.io, then paste its endpoint here.
FORMS_WEBHOOK_URL=https://formspree.io/f/your-form-id
# Optional: signs the JSON body (X-Signature: sha256=…) for your own receiver; Formspree ignores it.
FORMS_WEBHOOK_SECRET=

# Optional: email directly through Resend (https://resend.com). FROM must be on a domain verified in Resend.
RESEND_API_KEY=
FORMS_EMAIL_FROM="ION Insurance website <forms@ioninsuranceinc.com>"
FORMS_EMAIL_TO=info@ion.co.cr

# Local testing only: accept valid messages with no destination configured.
# FORMS_DRY_RUN=1
