# Nothing here is required. By default the form posts to the existing Gravity Forms form 1 on
# https://wp.ioninsuranceinc.com (WordPress's own hostname after the domain moves). Override only if it lives elsewhere.
# WORDPRESS_ORIGIN=
# Set to "email" at build time to use Resend/webhook below instead of Gravity Forms.
# NEXT_PUBLIC_FORMS_BACKEND=email
# Validation-only testing; never set this on the live deployment.
# FORMS_MODE=validate
# Alternative contact destinations (used only when NEXT_PUBLIC_FORMS_BACKEND=email).
# Email through Resend (https://resend.com). FROM must be on a domain verified in Resend.
RESEND_API_KEY=
FORMS_EMAIL_FROM="ION Insurance website <forms@ioninsuranceinc.com>"
FORMS_EMAIL_TO=info@ion.co.cr
# Optional: JSON to any endpoint (Zapier catch hook, CRM). The secret signs the body (X-Signature: sha256=…).
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=
# Local testing only: accept valid messages with no destination configured.
# FORMS_DRY_RUN=1
