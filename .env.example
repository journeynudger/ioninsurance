# Where contact-form messages go. Set at least one; a message counts as sent when any one accepts it.
# With none set, the form answers 503 and tells the visitor to email info@ion.co.cr.

# Recommended: Airtable. Each message becomes a row; an Airtable automation emails it.
# The table needs these columns, named exactly: First name, Last name, Email, Message, Submitted at.
# Token: a personal access token with only data.records:write, on this one base.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE="ION Website Messages"

# Optional: JSON to any endpoint (Formspree form, Zapier catch hook, your own receiver).
FORMS_WEBHOOK_URL=
# Optional: signs the JSON body (X-Signature: sha256=…) for your own receiver.
FORMS_WEBHOOK_SECRET=

# Optional: email directly through Resend (https://resend.com). FROM must be on a domain verified in Resend.
RESEND_API_KEY=
FORMS_EMAIL_FROM="ION Insurance website <forms@ioninsuranceinc.com>"
FORMS_EMAIL_TO=info@ion.co.cr

# Local testing only: accept valid messages with no destination configured.
# FORMS_DRY_RUN=1
